{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barspec.v2.schema.json",
  "title": "BarSpec v2: staged unit model checked by equations (see docs/spec-v2.md)",
  "type": "object",
  "required": ["version", "title", "level", "heuristic", "template", "question", "units", "quantities",
               "relations", "asked", "answer", "stages", "timeline"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "title": {"type": "string", "minLength": 1},
    "level": {"type": "string", "pattern": "^P[3-6](-P[3-6])?$"},
    "heuristic": {"type": "string", "enum": [
      "part_whole", "comparison", "multiples", "ratio", "how_many_more", "multi_step",
      "before_after", "equal_end", "constant_total", "constant_difference", "remainder", "fraction_of",
      "percentage", "percentage_change", "ratio_change", "units_and_value",
      "excess_shortage", "assumption", "average", "rate", "speed"]},
    "template": {"type": "string", "enum": ["bar", "bar-stages", "working"]},
    "board": {"type": "string", "enum": [
      "part_whole", "comparison", "before_after", "constant_difference", "remainder", "percentage",
      "ratio_change", "units_value_table", "two_scenarios", "assume_adjust", "average_level", "rate_speed",
      "working"]},
    "question": {"type": "string", "minLength": 1},
    "units": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "pattern": "^[a-z]$"}, "meaning": {"type": "string"}}}},
    "quantities": {"type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "required": ["id", "label"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "label": {"type": "string"}}}},
    "relations": {"type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "required": ["eq", "from"], "additionalProperties": false,
      "properties": {"eq": {"type": "string", "minLength": 3}, "from": {"type": "string", "minLength": 2}}}},
    "asked": {"type": "object", "required": ["expr", "label"], "additionalProperties": false,
      "properties": {"expr": {"type": "string"}, "label": {"type": "string"}}},
    "answer": {"type": "number"},
    "stages": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "required": ["id", "label", "bars"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string"},
        "bars": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "required": ["id", "quantity", "label", "segments"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "quantity": {"type": "string"},
            "label": {"type": "string"},
            "segments": {"type": "array", "minItems": 1, "maxItems": 6, "items": {
              "type": "object", "required": ["expr"], "additionalProperties": false,
              "properties": {
                "expr": {"type": "string"},
                "style": {"type": "string", "enum": ["normal", "marked", "added", "removed"]},
                "label": {"type": "string"}}}}}}}}}},
    "timeline": {"type": "array", "minItems": 3, "items": {
      "type": "object", "required": ["do", "say"],
      "properties": {
        "do": {"type": "string", "enum": [
          "write_question", "highlight", "draw_stage", "draw_bar", "divide_units", "move_part",
          "bracket", "question_mark", "label_unit", "pause", "write", "answer", "table", "fill_cell",
          "number_line", "mark_point"]},
        "say": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "stage": {"type": "string"},
        "bar": {"type": "string"},
        "bars": {"type": "array", "items": {"type": "string"}},
        "segments": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "side": {"type": "string", "enum": ["right", "top", "bottom"]},
        "from": {"type": "string"},
        "from_segment": {"type": "integer", "minimum": 0},
        "to": {"type": "string"},
        "to_segment": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "columns": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": ["string", "number"]}},
        "rows": {"type": "array", "minItems": 1, "maxItems": 6, "items": {
          "type": "array", "items": {"type": ["string", "number"]}}},
        "table": {"type": "string"},
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "start": {"type": "number"},
        "end": {"type": "number"},
        "marks": {"type": "array", "minItems": 2, "maxItems": 8, "items": {
          "type": "object", "required": ["at"], "additionalProperties": false,
          "properties": {"at": {"type": "number"}, "label": {"type": ["string", "number"]},
                         "value": {"type": ["string", "number"]}}}},
        "jumps": {"type": "array", "maxItems": 6, "items": {
          "type": "object", "required": ["from", "to"], "additionalProperties": false,
          "properties": {"from": {"type": "number"}, "to": {"type": "number"}, "label": {"type": ["string", "number"]}}}},
        "line": {"type": "string"},
        "at": {"type": "number"}
      }}}
  }
}
